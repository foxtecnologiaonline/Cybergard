# --- Infra ---
DATABASE_URL=postgres://cybergard:cybergard@localhost:5432/cybergard
REDIS_URL=redis://localhost:6379

# Chave AES-256-GCM (32 bytes em base64) usada para cifrar credenciais de fonte de log.
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEY=

# Chave usada para assinar cookie de sessão e o link assinado do alerta (HMAC-SHA256, 32 bytes em base64).
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# Máximo de eventos por chamada e limite de chamadas por minuto, por fonte de log (token).
INGEST_MAX_BATCH=500
INGEST_RATE_LIMIT_PER_MINUTE=120

# --- Azure AD (client credentials) ---
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- Azure Monitor / Logs Ingestion API (DCR) ---
# Endpoint do Data Collection Endpoint, ex.: https://cybergard-dce-xxxx.brazilsouth-1.ingest.monitor.azure.com
AZURE_DCE_ENDPOINT=
AZURE_DCR_IMMUTABLE_ID=
AZURE_DCR_STREAM_NAME=Custom-CybergardLogs_CL

# --- Microsoft Sentinel (workspace onde os incidentes são lidos) ---
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_WORKSPACE_NAME=

# --- Azure AI Anomaly Detector ---
AZURE_ANOMALY_ENDPOINT=https://<recurso>.cognitiveservices.azure.com
AZURE_ANOMALY_KEY=

# --- WhatsApp (Meta Business / Cloud API) ---
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=cybergard_alerta
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
# String arbitrária que você escolhe e cadastra no painel da Meta ao configurar o webhook.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# App secret do app da Meta — usado para validar a assinatura X-Hub-Signature-256 do webhook.
WHATSAPP_APP_SECRET=

# --- Operação ---
# Janela de retenção de log bruto (LGPD: minimização). Alertas ficam mais tempo que log bruto.
RAW_LOG_RETENTION_DAYS=30
ALERT_RETENTION_DAYS=365
SENTINEL_POLL_INTERVAL_MS=60000
ANOMALY_SCAN_INTERVAL_MS=300000
WORKER_HEARTBEAT_INTERVAL_MS=30000
LOG_LEVEL=info

# Base URL usada em links de alerta enviados ao usuário.
APP_BASE_URL=http://localhost:3000
